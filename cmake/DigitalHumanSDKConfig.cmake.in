@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# 必选依赖
find_dependency(OpenCV)
find_dependency(OpenMP)

# ncnn — 通过 CONFIG 查找，与主 CMakeLists 一致
if(DEFINED VCPKG_INSTALLED_DIR AND DEFINED VCPKG_TARGET_TRIPLET
   AND EXISTS "${VCPKG_INSTALLED_DIR}/${VCPKG_TARGET_TRIPLET}/share/ncnn/ncnnConfig.cmake")
    find_dependency(ncnn CONFIG PATHS "${VCPKG_INSTALLED_DIR}/${VCPKG_TARGET_TRIPLET}/share/ncnn" NO_DEFAULT_PATH)
else()
    find_dependency(ncnn CONFIG)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/DigitalHumanSDKTargets.cmake")

set(DigitalHumanSDK_FOUND TRUE)
